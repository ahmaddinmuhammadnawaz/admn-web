          crawl={true}
          showSpinner={false}
          easing="ease"
          speed={200}
          shadow="0 0 10px #131924,0 0 5px #131924"
          zIndex={1600}
        />
        
        <AutoLogout />
        
        {children}
      </body>
    </html>
  );
}
